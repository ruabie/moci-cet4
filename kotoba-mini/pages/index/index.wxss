.shell{padding:34rpx 36rpx calc(38rpx + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box;}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:10rpx 0 44rpx;border-bottom:1rpx solid #dbd9d1;}
.brand{font-size:44rpx;font-weight:700;letter-spacing:-1.5rpx;}
.brand-sub{display:block;font-size:14rpx;font-weight:600;letter-spacing:2rpx;color:#818781;margin-top:4rpx;}
.tag{font-size:17rpx;color:#969a96;letter-spacing:1.4rpx;}
.hero{padding:70rpx 0 50rpx;display:flex;flex-direction:column;}
.eyebrow{font-size:19rpx;letter-spacing:2.5rpx;font-weight:650;color:#888e85;margin:24rpx 0;display:block;}
.hero-title,.page-title{font-size:66rpx;line-height:1.26;font-weight:760;letter-spacing:-2rpx;display:flex;flex-direction:column;margin:24rpx 0;}
.hero-title text,.page-title text{font-weight:450;color:#697c69;}
.hero-desc,.muted{color:#777d75;font-size:25rpx;line-height:1.8;display:block;}
.hero-desc{max-width:580rpx;margin-top:18rpx;}
.stat-bar{display:flex;justify-content:space-around;padding:34rpx 12rpx;border-top:1rpx solid #d9d9d1;border-bottom:1rpx solid #d9d9d1;margin-bottom:50rpx;}
.stat-bar>view{display:flex;flex-direction:column;align-items:center;flex:1;}
.stat-number{font-size:49rpx;font-weight:700;}
.stat-desc{font-size:20rpx;color:#888d86;margin-top:10rpx;}
.section-title{font-weight:700;font-size:28rpx;display:flex;justify-content:space-between;align-items:center;margin-bottom:18rpx;}
.section-title text{font-size:16rpx;letter-spacing:1.8rpx;color:#a0a39b;}
.entry,.lesson-row{border-bottom:1rpx solid #dddcd4;padding:30rpx 0;display:flex;align-items:center;gap:24rpx;}
.entry-index,.lesson-index{font-size:25rpx;color:#8f958f;min-width:55rpx;}
.entry-main,.lesson-text{display:flex;flex-direction:column;flex:1;min-width:0;gap:10rpx;}
.entry-main>text:first-child{font-size:32rpx;font-weight:650;}
.entry-desc,.lesson-desc{font-size:21rpx;color:#8b8e87;line-height:1.5;}
.arrow{font-size:42rpx;color:#667c6d;}
.foot-links{display:flex;justify-content:space-between;margin:45rpx 0;color:#707b73;font-size:23rpx;}
.footer{color:#a9aaa3;text-align:center;letter-spacing:3rpx;font-size:15rpx;margin:80rpx 0 20rpx;}
.back{display:block;margin:42rpx 0;color:#707d75;font-size:25rpx;}
.volume-title{display:flex;justify-content:space-between;font-size:30rpx;font-weight:700;border-bottom:2rpx solid #a9b3a9;padding:26rpx 0 14rpx;margin-top:40rpx;}
.volume-title text{font-size:21rpx;font-weight:400;color:#888e85;}
.lesson-index{font-size:37rpx;}
.lesson-name{font-size:28rpx;font-weight:650;}
.lesson-count{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx;}
.lesson-count>text:first-child{font-size:36rpx;font-weight:700;}
.lesson-count>text:last-child{font-size:18rpx;color:#8a8e88;}
.sheet{border:1rpx solid #deddd5;background:#fcfbf7;border-radius:16rpx;padding:38rpx 30rpx;margin:42rpx 0;}
.sheet-top{font-size:25rpx;color:#707870;display:flex;align-items:center;justify-content:space-between;padding-bottom:25rpx;border-bottom:1rpx solid #e7e5dc;}
.big-number{font-size:75rpx;font-weight:700;color:#334337;display:block;}
.field-label{font-size:24rpx;font-weight:650;display:block;margin:30rpx 0 15rpx;}
.qty-input{padding:18rpx 0;font-size:45rpx;font-weight:700;border-bottom:1rpx solid #babfb4;}
.pill-bar{display:flex;gap:18rpx;margin:30rpx 0;}
.pill-bar text{border:1rpx solid #ccd3c8;padding:14rpx 27rpx;border-radius:100rpx;font-size:24rpx;color:#5d745f;}
button.primary,button.secondary{border-radius:12rpx;padding:10rpx 20rpx;min-height:90rpx;line-height:70rpx;font-size:28rpx;margin:22rpx 0;box-sizing:border-box;}
button.primary{background:#344d3c;color:#fff;}
button.primary[disabled]{background:#a4ada4;color:#e7eae5;}
button.secondary{background:transparent;border:1rpx solid #c8d0c8;color:#536756;}
.center{text-align:center;display:flex;align-items:center;flex-direction:column;gap:20rpx;}
.center-link{color:#6d7a70;text-align:center;display:block;margin:27rpx 0;font-size:23rpx;line-height:1.6;}
.studybar{display:flex;justify-content:space-between;align-items:center;padding:25rpx 0 15rpx;color:#758276;font-size:24rpx;}
.progress-track{height:4rpx;background:#e0e3da;width:100%;overflow:hidden;}
.progress-fill{height:4rpx;background:#7a927f;transition:width .15s;}
.flashcard{min-height:62vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:29rpx;padding:15rpx 18rpx;box-sizing:border-box;}
.card-jp{font-size:78rpx;line-height:1.35;letter-spacing:-1.5rpx;font-weight:700;text-align:center;word-break:break-all;}
.card-kana{font-size:32rpx;color:#6e8778;line-height:1.5;text-align:center;}
.card-cn{font-size:39rpx;text-align:center;line-height:1.55;font-weight:550;}
.card-pos{font-size:23rpx;border:1rpx solid #d6dbcf;border-radius:100rpx;padding:12rpx 20rpx;color:#829184;}
.reveal-hint{font-size:23rpx;color:#a2a8a0;margin-top:20rpx;}
.study-nav{display:flex;justify-content:space-between;font-size:27rpx;color:#526b57;padding:24rpx 6rpx;}
.study-hint{display:block;text-align:center;font-size:20rpx;color:#9ca39a;}
.quiz-word{text-align:center;font-size:55rpx;line-height:1.5;font-weight:650;min-height:180rpx;margin:75rpx 0 50rpx;word-break:break-all;}
.answer,.custom-area{width:100%;min-height:140rpx;padding:25rpx;box-sizing:border-box;border-radius:12rpx;border:1rpx solid #ccd2ca;background:#fff;font-size:29rpx;}
.feedback{display:flex;flex-direction:column;align-items:center;gap:18rpx;border:1rpx solid #d9dcd1;border-radius:14rpx;padding:34rpx 20rpx;margin:30rpx 0;text-align:center;}
.feedback-header{color:#62806a;font-size:25rpx;font-weight:700;}
.feedback-jp{font-size:52rpx;font-weight:700;}
.feedback-cn{font-size:30rpx;}
.small-gap{margin:18rpx 0;}
.score{font-size:92rpx;font-weight:750;color:#486b50;}
.search{margin:20rpx 0;padding:25rpx 18rpx;border:1rpx solid #ccd3c9;border-radius:12rpx;background:#fff;font-size:26rpx;}
.word-row{border-bottom:1rpx solid #dfdfd6;padding:23rpx 0;display:flex;flex-direction:column;gap:14rpx;font-size:24rpx;line-height:1.6;}
.word-row>view{display:flex;gap:20rpx;align-items:baseline;}
.word-jp{font-size:32rpx;font-weight:650;}
.word-kana,.word-origin{font-size:21rpx;color:#929990;}
.filter{margin:20rpx 0;}
.custom-area{height:170rpx;margin:15rpx 0;}
.help-block{display:flex;flex-direction:column;gap:14rpx;padding:29rpx 0;border-bottom:1rpx solid #dddcd4;}
.help-block text:first-child{font-size:25rpx;font-weight:700;color:#53715d;}
.help-block text:last-child{font-size:26rpx;line-height:1.8;color:#6e756d;}
